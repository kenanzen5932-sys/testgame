{
  "rewrites": [
    {
      "source": "/avatar-proxy/:path*",
      "destination": "https://cdn.apexparty.live/:path*"
    },
    {
      "source": "/game/fe-game-cocos-js-hm/:path*",
      "destination": "/cocos-js/:path*"
    },
    {
      "source": "/game/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/bridge-inject.js",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/bridge-inject-v2.js",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
